# .env.example — plantilla para crear .env.local en desarrollo.
# Copiar a `.env.local` y rellenar. Nunca commitear valores reales.
# Prod se configura en Vercel Settings → Environment Variables.

# ─── Base de datos (Supabase) ────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ─── Mapbox (cliente) ────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── NextAuth ────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Usado para construir links absolutos en emails (digest, notificaciones).
# Si no se configura, los helpers usan https://warroom.fontiber.com.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Credenciales admin (war room) ───────────────────────────────────────
# Los finders NO usan estas variables — su auth es bcrypt contra la tabla
# Finder y su password se setea desde /finders en el war room.
ADMIN_USER_1=alberto
ADMIN_PASS_1=
ADMIN_USER_2=gabriel
ADMIN_PASS_2=

# ─── Integraciones externas ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
RESEND_API_KEY=
APISPAIN_KEY=

# ─── Emails ──────────────────────────────────────────────────────────────
SUMMARY_EMAIL_TO=alberto@fontiber.com,gabriel@fontiber.com
SUMMARY_EMAIL_FROM=warroom@fontiber.com

# Remitente para emails dirigidos a finders (reset de contraseña, etc).
# Mismo dominio verificado en Resend que SUMMARY_EMAIL_FROM, alias distinto.
PORTAL_EMAIL_FROM=portal@fontiber.com

# Opcional: remitente para el reset de contraseña de Alberto/Gabriel.
# Si se omite, usa SUMMARY_EMAIL_FROM y después warroom@fontiber.com.
ADMIN_EMAIL_FROM=warroom@fontiber.com

# Opcional: sobrescribe destinatarios de notifyAdmins (PRs de propuestas, etc).
# Si no se configura, manda a todos los User.role="admin" activos.
# NOTIFICATION_EMAIL_TO=alberto@fontiber.com

# ─── Microsoft Graph (OneDrive + Mail.Read) ──────────────────────────────
# App registration "War Room - OneDrive Sync" en Azure AD. Application
# permissions: Files.Read.All + Sites.Read.All + Mail.Read (admin consent).
# Mail.Read está limitado a `EMAIL_TASK_OWNER_UPNS` vía Application Access
# Policy en Exchange Online (New-ApplicationAccessPolicy).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# OneDrive — buzón propietario de la carpeta Targets y ruta dentro de él.
ONEDRIVE_OWNER_UPN=alberto@fontiber.com
ONEDRIVE_TARGETS_PATH=

# Notion — integration "War Room" con acceso a página padre Targets.
NOTION_API_KEY=
NOTION_TARGETS_PAGE_ID=

# Cron de auto-tarea por email: lista coma-separada de UPNs cuyos SentItems
# se leen vía Graph para crear tareas automáticas al matchear con Contacto.
EMAIL_TASK_OWNER_UPNS=alberto@fontiber.com,gabriel@fontiber.com

# ─── Cron (solo en Vercel) ───────────────────────────────────────────────
# En local no es necesario — los scripts de scripts/ van con dotenv-cli.
CRON_SECRET=

# ─── BORME scripts opcionales ────────────────────────────────────────────
# BACKFILL_MONTHS=6
# START_DATE=YYYY-MM-DD
