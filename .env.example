# .env.example — plantilla para crear .env.local en desarrollo.
# Copiar a `.env.local` y rellenar. Nunca commitear valores reales.
# Prod se configura en Vercel Settings → Environment Variables.

# ─── Base de datos (Supabase) ────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ─── Mapbox (cliente) ────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── NextAuth ────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Credenciales admin (war room) ───────────────────────────────────────
# Los finders NO usan estas variables — su auth es bcrypt contra la tabla
# Finder y su password se setea desde /finders en el war room.
ADMIN_USER_1=alberto
ADMIN_PASS_1=
ADMIN_USER_2=gabriel
ADMIN_PASS_2=

# ─── Integraciones externas ──────────────────────────────────────────────
PIPEDRIVE_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
APISPAIN_KEY=

# ─── Emails ──────────────────────────────────────────────────────────────
SUMMARY_EMAIL_TO=alberto@fontiber.com,gabriel@fontiber.com
SUMMARY_EMAIL_FROM=warroom@fontiber.com

# ─── Cron (solo en Vercel) ───────────────────────────────────────────────
# En local no es necesario — los scripts de scripts/ van con dotenv-cli.
CRON_SECRET=

# ─── BORME scripts opcionales ────────────────────────────────────────────
# BACKFILL_MONTHS=6
# START_DATE=YYYY-MM-DD
