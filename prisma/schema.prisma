generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Grupo {
  id            Int            @id @default(autoincrement())
  nombre        String
  tipo          String         // "nacional"|"PE"|"familiar"|"multinacional"
  paisOrigen    String?
  notas         String?
  empresas      Empresa[]
  bormeAlertas  BormeAlerta[]
}

model Empresa {
  id               Int           @id @default(autoincrement())
  cif              String        @unique
  nombre           String
  direccion        String?
  codigoPostal     String?
  telefono         String?
  localidad        String?
  provincia        String?       // null hasta geocoding
  ccaa             String?       // null hasta geocoding
  lat              Float?
  lng              Float?
  sector           String?       // "PCI"|"seguridad_electronica"|"mixto" — asignar manualmente
  servicios        String?       // JSON array
  grupoId          Int?
  grupo            Grupo?        @relation(fields: [grupoId], references: [id])
  // fuente: Excel — no sobreescribir desde otras fuentes
  empleados        Int?
  // Enriquecimiento: web y linkedin desde Excel (empresas conocidas) o fuentes web
  web              String?     // fuente: Excel para grupos grandes; web para resto
  linkedin         String?
  logoUrl          String?
  descripcion      String?
  cepreven         String?       // null = n/a, "asociada", "calificada"
  aerme            Boolean       @default(false)
  ambitoGeo        String?       // "E" = estatal | "A" = autonómico — solo seg. electrónica
  // Perímetro y scoring
  enPerimetro      Boolean       @default(true)
  enPerimetroAt    DateTime?
  scoreInicial     Float?
  score            Float?
  anioConstitucion Int?          // año de constitución (fuente: empresia)
  // Leads anónimos: la identidad real del target no se conoce (confidencial).
  // CIF se genera como "LEAD-{id}" internamente. nombre = alias acordado (ej. "Asher").
  // Una vez revelada la identidad, se usa el endpoint de vinculación para mover
  // relaciones (tareas, notas, actividades, CrmLog, finder) a la Empresa real y
  // borrar el lead. Estos no aparecen en mapa, tabla, BORME ni stats del universo.
  esAnonima        Boolean       @default(false)
  // Documentación externa (OneDrive + Notion). Se usan a partir de "primera_reunion".
  // - oneDriveUrl / notionUrl: URLs absolutas a la carpeta/página del target.
  //   Pueden poblarse manualmente desde el panel o automáticamente vía Microsoft Graph
  //   y Notion API (matching por nombre normalizado o nombreComercial).
  // - nombreComercial: alias usado en OneDrive/Notion cuando difiere del nombre legal
  //   (e.g. "Extintores Pamplona SL" → "FireProtect"). Lo usa el matcher.
  oneDriveUrl      String?
  notionUrl        String?
  nombreComercial  String?
  // Control
  fuente           String        @default("excel_seed")
  updatedAt        DateTime      @updatedAt
  // Relaciones
  financieros      Financiero[]
  bormeAlertas     BormeAlerta[]
  bormePersonas    BormePersona[]
  personasCargo    PersonaCargo[]
  crmEstado        CrmEstado?
  crmLogs          CrmLog[]
  notas            Nota[]
  tareas           Tarea[]
  contactos        Contacto[]
  // CRM finder module
  finderSourceId   String?
  finderSource     Finder?       @relation(fields: [finderSourceId], references: [id])
  finderNotes      FinderNote[]
  proposals        TargetProposal[]

  @@index([nombre])
  @@index([fuente])
  @@index([finderSourceId])
  @@index([esAnonima])
}

// Contactos M&A (no confundir con PersonaCargo, que es BORME — administradores
// legales). Aquí guardamos el director general, responsable de compras o quien
// quiera que estemos hablando, con su email para que el matcher del cron
// SentItems pueda crear tareas automáticamente al mandar email.
model Contacto {
  id               Int                @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre           String
  cargo            String?
  email            String?
  telefono         String?
  notas            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  emailIngests     EmailIngest[]
  calendarIngests  CalendarIngest[]

  @@index([empresaId])
  @@index([email]) // matcher rápido del cron SentItems + Calendar Microsoft Graph
}

// Cursor por buzón leído por el cron SentItems → tareas. Una fila por UPN
// (alberto@, gabriel@). `lastSentDateTime` es la fecha del último email YA
// procesado; el cron filtra `sentDateTime gt lastSentDateTime` para procesar
// solo los nuevos. Se actualiza atómicamente al final de cada ronda exitosa.
model EmailIngestCursor {
  upn              String   @id
  lastSentDateTime DateTime
  updatedAt        DateTime @updatedAt
}

// Traza + dedup de emails procesados por el cron SentItems. Un email del
// buzón Graph (`internetMessageId`) se procesa una sola vez. Si matchea con
// un Contacto, se crea una Tarea ligada vía `tareaId` y se persiste aquí
// para evitar duplicados. Si NO matchea, no se persiste nada (privacy: solo
// guardamos metadata de los emails que sí entran al CRM).
model EmailIngest {
  id                Int       @id @default(autoincrement())
  internetMessageId String    @unique
  upn               String
  recipientEmail    String
  contactoId        Int?
  contacto          Contacto? @relation(fields: [contactoId], references: [id], onDelete: SetNull)
  empresaId         Int
  tareaId           Int?      @unique
  tarea             Tarea?    @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  sentAt            DateTime
  subject           String?
  createdAt         DateTime  @default(now())

  @@index([upn])
  @@index([sentAt])
  @@index([empresaId])
}

// Cursor por buzón leído por el cron Calendar → tareas. Una fila por UPN
// (alberto@, gabriel@). Filtramos por `lastModifiedDateTime` (no `start`)
// para capturar también re-schedules y cancelaciones de eventos antiguos.
model CalendarIngestCursor {
  upn                 String   @id
  lastModifiedDateTime DateTime
  updatedAt           DateTime @updatedAt
}

// Traza + dedup de eventos de calendar procesados por el cron. Un evento de
// Graph se identifica por `iCalUId` (estable cross-user: si alberto Y gabriel
// están en la misma reunión, sus calendarios tienen el mismo iCalUId pero
// distinto `id`). Usamos iCalUId como unique para no duplicar la tarea cuando
// el cron procesa ambos calendarios. `graphEventId` se guarda informativo
// (event.id del calendario del UPN que procesamos primero).
//
// Privacy: igual que email, eventos sin match con Contacto no dejan rastro.
model CalendarIngest {
  id              Int       @id @default(autoincrement())
  iCalUId         String    @unique
  graphEventId    String
  upn             String
  organizerEmail  String
  recipientEmail  String    // El asistente que matcheó con un Contacto
  contactoId      Int?
  contacto        Contacto? @relation(fields: [contactoId], references: [id], onDelete: SetNull)
  empresaId       Int
  tareaId         Int?      @unique
  tarea           Tarea?    @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  startAt         DateTime
  endAt           DateTime
  subject         String?
  isOnlineMeeting Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([upn])
  @@index([startAt])
  @@index([empresaId])
  @@index([graphEventId])
}

model Financiero {
  id             Int      @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  anio          Int
  // Valores absolutos € — vienen del Excel, nunca calculados
  ingresos      Float?
  margenBruto   Float?   // absoluto €; margenBrutoPct = margenBruto/ingresos*100 (API)
  ebitda        Float?   // absoluto €; ebitdaPct = ebitda/ingresos*100 (API)
  resultadoNeto Float?
  fuente         String?
  updatedAt      DateTime @updatedAt

  @@unique([empresaId, anio])
}

model BormeAlerta {
  id               Int            @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa        @relation(fields: [empresaId], references: [id])
  fecha            DateTime
  tipoActo         String         // "fusion"|"adquisicion"|"cambio_denominacion"|"nombramiento_grupo"|"nombramiento"|"disolucion"|"otros"
  descripcion      String?
  urlBorme         String?
  leido            Boolean        @default(false)
  // Grupo inference
  grupoInferidoId  Int?
  grupoInferido    Grupo?         @relation(fields: [grupoInferidoId], references: [id])
  personaDetectada String?        // nombre normalizado de la persona clave detectada
  createdAt        DateTime       @default(now())
  personas         BormePersona[]

  @@index([fecha])
}

model BormePersona {
  id          Int         @id @default(autoincrement())
  alertaId    Int
  alerta      BormeAlerta @relation(fields: [alertaId], references: [id])
  empresaId   Int
  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  nombreNorm  String      // MAYUSCULAS sin diacríticos — clave de agrupación
  rol         String?     // "apoderado"|"administrador"|"consejero"|etc.
  fecha       DateTime
  createdAt   DateTime    @default(now())

  @@index([nombreNorm])
  @@index([empresaId])
  @@index([alertaId])
}

model PersonaCargo {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  nombreNorm  String   // tokens sin partículas, ordenados alfabéticamente, mayúsculas sin tildes: "DAVID LOPEZ LOPEZ"
  nombreOrig  String   // tal como aparece en la fuente: "David López López"
  rol         String?  // "administrador"|"consejero"|"apoderado"|etc.
  fechaDesde  DateTime?
  esJuridica  Boolean  @default(false) // true = persona jurídica (empresa), false = persona física
  vigente     Boolean  @default(true)
  fuente      String   // "empresia" | "borme"
  scrapedAt   DateTime @default(now())

  @@unique([empresaId, nombreNorm])
  @@index([nombreNorm])
  @@index([empresaId])
  @@index([esJuridica])
}

model CrmEstado {
  id                 Int       @id @default(autoincrement())
  empresaId          Int       @unique
  empresa            Empresa   @relation(fields: [empresaId], references: [id])
  dealStage          String?   // "identificado"|"contactado"|"primera_reunion"|"analisis"|"LOI enviada"|"execution"|"portfolio"|"on_hold"|"muerto" — null = Sin CRM
  ownerUserId        String?
  ownerUser          User?     @relation("CrmOwner", fields: [ownerUserId], references: [id])
  fechaEntradaStage  DateTime? // cuándo entró al stage actual (para "X días en stage")
  updatedAt          DateTime  @updatedAt

  @@index([dealStage])
  @@index([ownerUserId])
}

model CrmLog {
  id             Int      @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  event          String   // "new_deal" | "stage_changed" | "removed_from_funnel"
  fromStage      String?
  toStage        String?
  autorId        String?
  autor          User?    @relation(fields: [autorId], references: [id])
  autorFinderId  String?
  autorFinder    Finder?  @relation("CrmLogAutorFinder", fields: [autorFinderId], references: [id])
  note           String?  // comentario opcional al cambiar stage
  createdAt      DateTime @default(now())

  @@index([empresaId])
  @@index([createdAt])
  @@index([autorId])
  @@index([autorFinderId])
}

// ─────────────────────────────────────────────────────────────
// CRM module — MVP 1 (users, notas, tareas)
//
// Tarea es el modelo unificado de "trabajo a hacer" Y "registro histórico":
//   - completada=false → tarea pendiente (futuro)
//   - completada=true + resultado != null → registro histórico de algo ya hecho
//
// El antiguo modelo Actividad (registro de llamadas/emails/reuniones legacy
// Pipedrive) se fusionó en Tarea — ver scripts/migrate-actividades-a-tareas-y-notas.ts.
// ─────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  role       String   @default("admin") // "admin" | "finder" (reservado MVP 1.5)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relaciones
  notas           Nota[]            @relation("NotaAutor")
  tareasCreadas   Tarea[]           @relation("TareaAutor")
  tareasAsignadas Tarea[]           @relation("TareaAsignado")
  crmLogs         CrmLog[]
  crmEstadosOwner CrmEstado[]       @relation("CrmOwner")
  notificaciones  Notificacion[]
  menciones       Mencion[]         @relation("UserMencion")
}

model Nota {
  id             Int      @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  // Autor: solo uno de los dos campos tiene valor.
  // - autorId set     → nota creada por un admin (User)
  // - autorFinderId   → nota creada por un finder desde el portal
  autorId        String?
  autor          User?    @relation("NotaAutor", fields: [autorId], references: [id])
  autorFinderId  String?
  autorFinder    Finder?  @relation("NotaAutorFinder", fields: [autorFinderId], references: [id])
  contenido      String   @db.Text
  // Si la nota la crea un admin, controla si el finder asignado la puede leer.
  // Default false = nota interna de admins. Las notas de finders siempre las ven
  // los admins (este flag no aplica a ellas).
  visibleAFinder Boolean  @default(false)
  // Threading: respuestas a otra nota. Profundidad ilimitada. Cuando la raíz
  // se borra, las respuestas también (cascade). La visibilidad al finder se
  // hereda del root al crear (se calcula en el endpoint POST, no en BD).
  parentId       Int?
  parent         Nota?    @relation("NotaThread", fields: [parentId], references: [id], onDelete: Cascade)
  respuestas     Nota[]   @relation("NotaThread")
  menciones      Mencion[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([empresaId, createdAt])
  @@index([autorId])
  @@index([autorFinderId])
  @@index([parentId])
}

model Tarea {
  id                  Int       @id @default(autoincrement())
  empresaId           Int
  empresa             Empresa   @relation(fields: [empresaId], references: [id])
  // Tipo de la acción. "email" se añadió tras la fusión con el antiguo Actividad.
  tipo                String    @default("otra") // contacto_linkedin|mensaje_whatsapp|llamada|videollamada|reunion_presencial|email|otra
  titulo              String
  descripcion         String?   @db.Text
  // Fecha asociada al item. Puede ser pasada (registro histórico) o futura (tarea pendiente).
  // Nombre legacy "fechaLimite" — se mantuvo al unificar Tarea+Actividad para evitar migración SQL.
  fechaLimite         DateTime?
  completada          Boolean   @default(false)
  completadaAt        DateTime?
  // Notas post-evento. Se rellena al marcar completada=true: qué pasó en la
  // reunión/llamada/email, próximos pasos, etc. El autor puede editar este campo
  // siempre (incluso con completada=true), porque es texto libre histórico.
  resultado           String?   @db.Text
  // Asignado: solo uno de los dos. Si un admin asigna a otro admin → asignadoId.
  // Si asigna al finder del deal → asignadoFinderId. Los finders solo pueden
  // autoasignarse (asignadoFinderId = su id) o crear tareas sin asignar.
  asignadoId          String?
  asignado            User?     @relation("TareaAsignado", fields: [asignadoId], references: [id])
  asignadoFinderId    String?
  asignadoFinder      Finder?   @relation("TareaAsignadoFinder", fields: [asignadoFinderId], references: [id])
  autorId             String?
  autor               User?     @relation("TareaAutor", fields: [autorId], references: [id])
  autorFinderId       String?
  autorFinder         Finder?   @relation("TareaAutorFinder", fields: [autorFinderId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Si la tarea fue creada por el cron SentItems, traza al EmailIngest.
  emailIngest         EmailIngest?
  // Si la tarea fue creada por el cron Calendar, traza al CalendarIngest.
  calendarIngest      CalendarIngest?
  menciones           Mencion[]

  @@index([empresaId])
  @@index([fechaLimite, completada])
  @@index([asignadoId, completada])
  @@index([asignadoFinderId, completada])
  @@index([autorFinderId])
  @@index([tipo])
}

// ─────────────────────────────────────────────────────────────
// Finder module — MVP 1.5 (portal de finders)
// Tablas preparadas ya en MVP 1 para registrar finders existentes.
// Las tablas NextAuth (FinderSession/Account/VerificationToken) se añaden en MVP 1.5.
// ─────────────────────────────────────────────────────────────

model Finder {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String
  active            Boolean           @default(true)
  commissionPct     Float?
  // Hash bcrypt de la contraseña del portal. null = aún no se le ha dado acceso.
  // Los admins (Alberto/Gabriel) son quienes generan/resetean la password vía
  // POST /api/finders/:id/password y se la comunican al finder por canal seguro.
  passwordHash      String?
  passwordSetAt     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  empresas          Empresa[]
  finderNotes       FinderNote[]
  proposals         TargetProposal[]
  accessLogs        FinderAccessLog[]
  notasAutor        Nota[]            @relation("NotaAutorFinder")
  tareasAutor       Tarea[]           @relation("TareaAutorFinder")
  tareasAsignadas   Tarea[]           @relation("TareaAsignadoFinder")
  crmLogsAutor      CrmLog[]          @relation("CrmLogAutorFinder")
  passwordResets    PasswordResetToken[]
  notificaciones    Notificacion[]    @relation("NotificacionFinder")
  menciones         Mencion[]         @relation("FinderMencion")
}

// Self-service reset de password para finders. El finder pide reset desde
// /portal/forgot-password → se crea un token (raw 64 hex chars) cuyo sha256
// se persiste en `tokenHash`. El raw viaja por email en el link. Pasada la
// `expiresAt` (24h) o usado (`usedAt` poblado) deja de servir. Pedir un nuevo
// token invalida los previos del mismo finder (marca usedAt = now).
model PasswordResetToken {
  id         String    @id @default(cuid())
  finderId   String
  finder     Finder    @relation(fields: [finderId], references: [id], onDelete: Cascade)
  // sha256 hex del token raw. Único para evitar colisiones improbables.
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([finderId, usedAt])
  @@index([expiresAt])
}

model FinderNote {
  id         Int      @id @default(autoincrement())
  finderId   String
  finder     Finder   @relation(fields: [finderId], references: [id])
  empresaId  Int
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  contenido  String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([finderId])
  @@index([empresaId])
}

model TargetProposal {
  id              Int             @id @default(autoincrement())
  finderId        String
  finder          Finder          @relation(fields: [finderId], references: [id])
  companyName     String
  cif             String?
  website         String?
  contactName     String?
  contactRole     String?
  notes           String?         @db.Text
  status          ProposalStatus  @default(PENDING)
  empresaId       Int?
  empresa         Empresa?        @relation(fields: [empresaId], references: [id])
  rejectionReason String?         // interno, nunca se expone al finder
  createdAt       DateTime        @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?         // User.id del admin que revisó

  @@index([finderId])
  @@index([status])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DUPLICATE
  OUT_OF_SCOPE
  REJECTED
}

model FinderAccessLog {
  id         Int       @id @default(autoincrement())
  finderId   String?
  finder     Finder?   @relation(fields: [finderId], references: [id])
  email      String?
  action     String    // "login_attempt"|"login_success"|"view_deals"|"view_deal"|"add_note"|"edit_note"|"delete_note"|"propose_target"
  resourceId String?
  ip         String?
  userAgent  String?   @db.Text
  createdAt  DateTime  @default(now())

  @@index([finderId])
  @@index([action, createdAt])
}

// Notificaciones in-app dirigidas a admins (User) O finders (Finder). Genérico
// para soportar tipos como "proposal_new", "nota_respuesta", "mencion", etc.
//
// Destinatario: exactamente UNO de los dos campos tiene valor. Convención
// mutex (no se persiste a nivel BD para evitar un CHECK constraint exótico
// sobre dos NULL/NOT NULL; los endpoints garantizan que solo uno está set).
model Notificacion {
  id         Int       @id @default(autoincrement())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  finderId   String?
  finder     Finder?   @relation("NotificacionFinder", fields: [finderId], references: [id])
  tipo       String    // "proposal_new" | "note_added" | "nota_respuesta" | "mencion" | ...
  titulo     String
  mensaje    String    @db.Text
  link       String?   // ruta dentro del war room (ej. "/finders/proposals?status=PENDING")
  leida      Boolean   @default(false)
  leidaAt    DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, leida, createdAt])
  @@index([finderId, leida, createdAt])
}

// Menciones (@) en el contenido de Notas y Tareas. Una mención apunta a
// EXACTAMENTE un destinatario (user o finder) y a EXACTAMENTE una entidad
// (nota o tarea). Permite consultar "qué cosas me han mencionado" en O(1)
// vía índices, sin reparsear el texto.
//
// Se persiste tras parsear el contenido en el endpoint POST/PATCH. Si la
// mención se elimina del texto al editar, la fila se borra (con onDelete:
// Cascade de la entidad padre, no perdura más allá de la vida del padre).
// Una entrada por (entidad, destinatario): si se menciona dos veces al
// mismo en el mismo texto, solo una mencion en BD (dedup en el parser).
model Mencion {
  id         Int      @id @default(autoincrement())
  notaId     Int?
  nota       Nota?    @relation(fields: [notaId], references: [id], onDelete: Cascade)
  tareaId    Int?
  tarea      Tarea?   @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation("UserMencion", fields: [userId], references: [id])
  finderId   String?
  finder     Finder?  @relation("FinderMencion", fields: [finderId], references: [id])
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([finderId, createdAt])
  @@index([notaId])
  @@index([tareaId])
}

// ─────────────────────────────────────────────────────────────
// AuditLog — trazabilidad genérica de cambios en el war room
// ─────────────────────────────────────────────────────────────
//
// Registra creaciones/ediciones/borrados de entidades sensibles. Complementa
// los logs específicos existentes (CrmLog para stages, FinderAccessLog para
// el portal del finder) — esos se mantienen como están y NO se duplican aquí.
//
// El actor se identifica por (actorType, actorId):
//   - actorType="admin" → actorId = User.id
//   - actorType="finder" → actorId = Finder.id
//   - actorType="system" → actorId = null (cron, migración, etc.)
//
// `before`/`after` capturan SOLO los campos que cambiaron (no el registro
// entero), para ahorrar espacio. En `create` solo hay `after`; en `delete`
// solo hay `before`.
model AuditLog {
  id          String   @id @default(cuid())
  actorType   String   // "admin" | "finder" | "system"
  actorId     String?
  action      String   // "create" | "update" | "delete"
  entityType  String   // "empresa" | "tarea" | "nota" | "finder"
  entityId    String?  // string para soportar tanto Int (Tarea/Nota/Empresa) como String (Finder/User)
  before      Json?
  after       Json?
  metadata    Json?    // contexto extra (ip, userAgent, ruta, etc.)
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([createdAt])
}
