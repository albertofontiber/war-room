generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Grupo {
  id            Int            @id @default(autoincrement())
  nombre        String
  tipo          String         // "nacional"|"PE"|"familiar"|"multinacional"
  paisOrigen    String?
  notas         String?
  empresas      Empresa[]
  bormeAlertas  BormeAlerta[]
}

model Empresa {
  id               Int           @id @default(autoincrement())
  cif              String        @unique
  nombre           String
  direccion        String?
  codigoPostal     String?
  telefono         String?
  localidad        String?
  provincia        String?       // null hasta geocoding
  ccaa             String?       // null hasta geocoding
  lat              Float?
  lng              Float?
  sector           String?       // "PCI"|"seguridad_electronica"|"mixto" — asignar manualmente
  servicios        String?       // JSON array
  grupoId          Int?
  grupo            Grupo?        @relation(fields: [grupoId], references: [id])
  // fuente: Excel — no sobreescribir desde otras fuentes
  empleados        Int?
  // Enriquecimiento: web y linkedin desde Excel (empresas conocidas) o fuentes web
  web              String?     // fuente: Excel para grupos grandes; web para resto
  linkedin         String?
  logoUrl          String?
  descripcion      String?
  cepreven         String?       // null = n/a, "asociada", "calificada"
  aerme            Boolean       @default(false)
  ambitoGeo        String?       // "E" = estatal | "A" = autonómico — solo seg. electrónica
  // Perímetro y scoring
  enPerimetro      Boolean       @default(true)
  enPerimetroAt    DateTime?
  scoreInicial     Float?
  score            Float?
  anioConstitucion Int?          // año de constitución (fuente: empresia)
  // Control
  fuente           String        @default("excel_seed")
  updatedAt        DateTime      @updatedAt
  // Relaciones
  financieros      Financiero[]
  bormeAlertas     BormeAlerta[]
  bormePersonas    BormePersona[]
  personasCargo    PersonaCargo[]
  crmEstado        CrmEstado?
  crmLogs          CrmLog[]
  actividades      Actividad[]
  notas            Nota[]
  tareas           Tarea[]
  // CRM finder module
  finderSourceId   String?
  finderSource     Finder?       @relation(fields: [finderSourceId], references: [id])
  finderNotes      FinderNote[]
  proposals        TargetProposal[]

  @@index([nombre])
  @@index([fuente])
  @@index([finderSourceId])
}

model Financiero {
  id             Int      @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  anio          Int
  // Valores absolutos € — vienen del Excel, nunca calculados
  ingresos      Float?
  margenBruto   Float?   // absoluto €; margenBrutoPct = margenBruto/ingresos*100 (API)
  ebitda        Float?   // absoluto €; ebitdaPct = ebitda/ingresos*100 (API)
  resultadoNeto Float?
  fuente         String?
  updatedAt      DateTime @updatedAt

  @@unique([empresaId, anio])
}

model BormeAlerta {
  id               Int            @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa        @relation(fields: [empresaId], references: [id])
  fecha            DateTime
  tipoActo         String         // "fusion"|"adquisicion"|"cambio_denominacion"|"nombramiento_grupo"|"nombramiento"|"disolucion"|"otros"
  descripcion      String?
  urlBorme         String?
  leido            Boolean        @default(false)
  // Grupo inference
  grupoInferidoId  Int?
  grupoInferido    Grupo?         @relation(fields: [grupoInferidoId], references: [id])
  personaDetectada String?        // nombre normalizado de la persona clave detectada
  createdAt        DateTime       @default(now())
  personas         BormePersona[]

  @@index([fecha])
}

model BormePersona {
  id          Int         @id @default(autoincrement())
  alertaId    Int
  alerta      BormeAlerta @relation(fields: [alertaId], references: [id])
  empresaId   Int
  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  nombreNorm  String      // MAYUSCULAS sin diacríticos — clave de agrupación
  rol         String?     // "apoderado"|"administrador"|"consejero"|etc.
  fecha       DateTime
  createdAt   DateTime    @default(now())

  @@index([nombreNorm])
  @@index([empresaId])
  @@index([alertaId])
}

model PersonaCargo {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  nombreNorm  String   // tokens sin partículas, ordenados alfabéticamente, mayúsculas sin tildes: "DAVID LOPEZ LOPEZ"
  nombreOrig  String   // tal como aparece en la fuente: "David López López"
  rol         String?  // "administrador"|"consejero"|"apoderado"|etc.
  fechaDesde  DateTime?
  esJuridica  Boolean  @default(false) // true = persona jurídica (empresa), false = persona física
  vigente     Boolean  @default(true)
  fuente      String   // "empresia" | "borme"
  scrapedAt   DateTime @default(now())

  @@unique([empresaId, nombreNorm])
  @@index([nombreNorm])
  @@index([empresaId])
  @@index([esJuridica])
}

model CrmEstado {
  id                 Int       @id @default(autoincrement())
  empresaId          Int       @unique
  empresa            Empresa   @relation(fields: [empresaId], references: [id])
  pipedriveOrgId     String?   // legacy Pipedrive, read-only tras cut-over
  dealStage          String?   // "identificado"|"contactado"|"primera_reunion"|"analisis"|"LOI enviada"|"execution"|"portfolio"|"muerto"
  owner              String?   // legacy string ("alberto"|"gabriel") — mantenido para compat
  ownerUserId        String?
  ownerUser          User?     @relation("CrmOwner", fields: [ownerUserId], references: [id])
  fechaEntradaStage  DateTime? // cuándo entró al stage actual (para "X días en stage")
  updatedAt          DateTime  @updatedAt

  @@index([dealStage])
  @@index([ownerUserId])
}

model CrmLog {
  id         Int      @id @default(autoincrement())
  empresaId  Int
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  event      String   // "new_deal" | "stage_changed" | "removed_from_funnel"
  fromStage  String?
  toStage    String?
  owner      String?  // legacy string
  autorId    String?
  autor      User?    @relation(fields: [autorId], references: [id])
  note       String?  // comentario opcional al cambiar stage
  createdAt  DateTime @default(now())

  @@index([empresaId])
  @@index([createdAt])
  @@index([autorId])
}

model Actividad {
  id             Int       @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa   @relation(fields: [empresaId], references: [id])
  pipedriveId    String?   @unique // null para actividades nativas War Room, set para legacy Pipedrive
  tipo           String    // "nota"|"llamada"|"email"|"reunion"
  texto          String?   @db.Text
  autor          String?   // legacy string (Pipedrive)
  autorId        String?
  autorUser      User?     @relation(fields: [autorId], references: [id])
  fecha          DateTime
  sincronizadoAt DateTime  @default(now())

  @@index([empresaId, fecha])
  @@index([autorId])
}

// ─────────────────────────────────────────────────────────────
// CRM module — MVP 1 (users, notas generales, tareas)
// ─────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  role       String   @default("admin") // "admin" | "finder" (reservado MVP 1.5)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relaciones
  notas           Nota[]            @relation("NotaAutor")
  tareasCreadas   Tarea[]           @relation("TareaAutor")
  tareasAsignadas Tarea[]           @relation("TareaAsignado")
  crmLogs         CrmLog[]
  actividades     Actividad[]
  crmEstadosOwner CrmEstado[]       @relation("CrmOwner")
}

model Nota {
  id         Int      @id @default(autoincrement())
  empresaId  Int
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  autorId    String
  autor      User     @relation("NotaAutor", fields: [autorId], references: [id])
  contenido  String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([empresaId, createdAt])
  @@index([autorId])
}

model Tarea {
  id           Int       @id @default(autoincrement())
  empresaId    Int
  empresa      Empresa   @relation(fields: [empresaId], references: [id])
  tipo         String    @default("otra") // contacto_linkedin|mensaje_whatsapp|llamada|reunion_presencial|otra
  titulo       String
  descripcion  String?   @db.Text
  fechaLimite  DateTime?
  completada   Boolean   @default(false)
  completadaAt DateTime?
  asignadoId   String?
  asignado     User?     @relation("TareaAsignado", fields: [asignadoId], references: [id])
  autorId      String
  autor        User      @relation("TareaAutor", fields: [autorId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([empresaId])
  @@index([fechaLimite, completada])
  @@index([asignadoId, completada])
  @@index([tipo])
}

// ─────────────────────────────────────────────────────────────
// Finder module — MVP 1.5 (portal de finders)
// Tablas preparadas ya en MVP 1 para registrar finders existentes.
// Las tablas NextAuth (FinderSession/Account/VerificationToken) se añaden en MVP 1.5.
// ─────────────────────────────────────────────────────────────

model Finder {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String
  active            Boolean           @default(true)
  commissionPct     Float?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  empresas          Empresa[]
  finderNotes       FinderNote[]
  proposals         TargetProposal[]
  accessLogs        FinderAccessLog[]
}

model FinderNote {
  id         Int      @id @default(autoincrement())
  finderId   String
  finder     Finder   @relation(fields: [finderId], references: [id])
  empresaId  Int
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  contenido  String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([finderId])
  @@index([empresaId])
}

model TargetProposal {
  id              Int             @id @default(autoincrement())
  finderId        String
  finder          Finder          @relation(fields: [finderId], references: [id])
  companyName     String
  cif             String?
  website         String?
  contactName     String?
  contactRole     String?
  notes           String?         @db.Text
  status          ProposalStatus  @default(PENDING)
  empresaId       Int?
  empresa         Empresa?        @relation(fields: [empresaId], references: [id])
  rejectionReason String?         // interno, nunca se expone al finder
  createdAt       DateTime        @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?         // User.id del admin que revisó

  @@index([finderId])
  @@index([status])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DUPLICATE
  OUT_OF_SCOPE
  REJECTED
}

model FinderAccessLog {
  id         Int       @id @default(autoincrement())
  finderId   String?
  finder     Finder?   @relation(fields: [finderId], references: [id])
  email      String?
  action     String    // "login_attempt"|"login_success"|"view_deals"|"view_deal"|"add_note"|"edit_note"|"delete_note"|"propose_target"
  resourceId String?
  ip         String?
  userAgent  String?   @db.Text
  createdAt  DateTime  @default(now())

  @@index([finderId])
  @@index([action, createdAt])
}
